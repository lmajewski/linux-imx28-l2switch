#include "vf500.dtsi"

&a5_cpu {
	next-level-cache = <&L2>;
};

&aips0 {
	L2: cache-controller@40006000 {
		compatible = "arm,pl310-cache";
		reg = <0x40006000 0x1000>;
		cache-unified;
		cache-level = <2>;
		arm,data-latency = <3 3 3>;
		arm,tag-latency = <2 2 2>;
	};
};

&aips1 {
	eth_switch: switch@400e8000 {
		compatible = "nxp,vf610-mtip-switch";
		reg = <0x400e8000 0x8000 0x400d0000 0x2000>;
		interrupts = <82 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "mtipl2sw";
		clocks = <&clks VF610_CLK_ESW>,
				<&clks VF610_CLK_ESW_MAC_TAB0>,
				<&clks VF610_CLK_ESW_MAC_TAB1>,
				<&clks VF610_CLK_ESW_MAC_TAB2>,
				<&clks VF610_CLK_ESW_MAC_TAB3>,
				<&clks VF610_CLK_ENET0>,
				<&clks VF610_CLK_ENET0>,
				<&clks VF610_CLK_ENET1>,
				<&clks VF610_CLK_ENET1>,
				<&clks VF610_CLK_ENET>;
		clock-names = "esw", "esw_tab0", "esw_tab1", "esw_tab2", "esw_tab3", "ipg", "ahb", "ipg1", "ahb1", "ptp";
		status = "disabled";
	};
};
